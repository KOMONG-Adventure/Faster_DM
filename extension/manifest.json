{
  "manifest_version": 3,
  "name": "Faster DM",
  "version": "0.6.2",
  "description": "Chrome/Edge-ээс файл болон YouTube холбоосыг Faster DM рүү дамжуулна.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Faster DM"
  }
}
